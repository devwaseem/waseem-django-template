DJANGO_SETTINGS_MODULE={{ cookiecutter.project_slug }}.settings.dev
DEBUG=true
SECRET_KEY=development-only-change-me-to-a-longer-secret-key-000000000
APP_VERSION=0.1.0
APP_BUILD_SHA=development
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_ID=1
ACCOUNT_ALLOW_REGISTRATION=true
ENABLE_ADMIN_HIJACK=false

POSTGRES_DB={{ cookiecutter.project_slug }}
POSTGRES_USER={{ cookiecutter.project_slug }}
POSTGRES_PASSWORD={{ cookiecutter.project_slug }}
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
DB_CONNECT_TIMEOUT=10
CONN_MAX_AGE=0
REDIS_HOST_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@example.test
SERVER_EMAIL=system@example.test

USE_SSL=false
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME={{ cookiecutter.project_slug }}

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_TIMEOUT_KEEP_ALIVE=5
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30

STATIC_USE_S3=false
MEDIA_USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
{% if cookiecutter.enable_celery == "yes" %}
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
{% endif -%}
