{
  "name": "{{ cookiecutter.project_slug }}",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"hyper/**/*.{css,ts}\" \"tests/e2e/**/*.ts\" playwright.config.ts vite.config.ts",
    "format:check": "prettier --check \"hyper/**/*.{css,ts}\" \"tests/e2e/**/*.ts\" playwright.config.ts vite.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "alpinejs": "^3.15.8",
    "tailwindcss": "^4.1.18",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.13.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3"
  }
}
